# Mengabaikan folder node_modules yang berisi library dan dependency project
node_modules

# Mengabaikan file .DS_Store yang biasanya dibuat otomatis oleh sistem macOS
.DS_Store

# Mengabaikan folder dist yang berisi hasil build aplikasi
dist

# Mengabaikan folder dist-ssr yang berisi hasil build untuk Server-Side Rendering
dist-ssr

# Mengabaikan semua file yang memiliki ekstensi .local
*.local
